{
  "manifest_version": 3,
  "name": "cympfh-fox",
  "version": "0.1.0",
  "description": "Personal Firefox extension for cympfh",
  "permissions": [
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.nicovideo.jp/*",
    "https://www.bilibili.com/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.nicovideo.jp/watch/*",
        "https://www.bilibili.com/video/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cympfh-fox@cympfh.cc",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
